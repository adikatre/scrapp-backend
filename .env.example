ADAPTION_API_KEY=
# Optional vision-capable model override
# ADAPTION_MODEL=gemma-4-26b-a4b-it
# ADAPTION_TIMEOUT_SECONDS=20
# ADAPTION_ENABLED=false
# Alternative provider when ADAPTION_API_KEY is empty
OPENAI_API_KEY=
USE_YOLO=false
# Optional comma-separated extra origins (e.g. http://localhost:3000 for local dev)
# CORS_ORIGINS=

# Shared secret the frontend must send as `Authorization: Bearer <key>`. Must be same on both servers.
# Generate with: openssl rand -hex 32
BACKEND_API_KEY=
